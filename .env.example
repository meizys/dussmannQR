# ── PWA (Vite, client-side) ───────────────────────────────────────────────────
# Optional: point at a real vision-extraction endpoint (see src/lib/vision.ts).
# If unset, SnapMeter uses the built-in deterministic mock extractor so the
# proof-of-concept runs with no backend or API keys.
# For the bundled local proxy below, this is its address:
# VITE_VISION_API_URL=http://localhost:8787/extract

# ── Vision proxy (server-side, see server/vision-extract.mjs) ─────────────────
# The proxy holds your Anthropic key so it never ships to the browser.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides:
# VISION_PORT=8787
# VISION_MODEL=claude-opus-4-8        # cheaper options: claude-haiku-4-5, claude-sonnet-4-6
# VISION_ALLOW_ORIGIN=*               # tighten to your PWA origin in production
